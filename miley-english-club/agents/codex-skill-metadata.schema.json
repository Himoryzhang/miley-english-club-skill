{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file:./codex-skill-metadata.schema.json",
  "title": "Codex Skill Metadata",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "short_description": {
          "type": "string",
          "minLength": 1
        },
        "icon_small": {
          "type": "string",
          "minLength": 1
        },
        "icon_large": {
          "type": "string",
          "minLength": 1
        },
        "brand_color": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
        },
        "default_prompt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "transport": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ]
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_implicit_invocation": {
          "type": "boolean"
        }
      }
    }
  }
}
